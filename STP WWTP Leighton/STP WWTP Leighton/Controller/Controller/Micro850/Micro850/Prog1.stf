PROGRAM Prog1
// =========================================================================
// 1. KALKULASI SETPOINT FLOW (RUMUS 4.1 PCP) & PEMANGGILAN TIMER
// =========================================================================
Q_b := HMI_Qa_CMD / 24.0;
IF HMI_Tr_Min > 0.0 THEN 
    Q_c := (Q_b * (HMI_Tr_Min + HMI_Ts_Min)) / HMI_Tr_Min;
ELSE
    Q_c := 0.0;
END_IF;

SET_Flow_Perm_HH := Q_c * 1.08; 
SET_Flow_Perm_LL := Q_c * 0.70; 

// --- Timer Faults & Alarms: Tekanan 10s (Tabel 4.3 & 4.4) ---
TON_PT101_HH(IN := (AIPT_101 <= -0.40), PT := T#10s); // Fault
TON_PT101_H(IN := (AIPT_101 <= -0.37), PT := T#10s);  // Alarm Interlock MBR
TON_PT_BW_HH(IN := (AIPT_BW >= 2.0), PT := T#10s);    // Fault
TON_PT_BW_H(IN := (AIPT_BW >= 1.8), PT := T#10s);     // Alarm Interlock BW (Asumsi 1.8)

// --- Timer Faults: No Flow 10s ---
TON_NoFlow_Permeate(IN := (Cmd_Auto_TP03 AND AIFT_101 <= 0.1), PT := T#10s);
TON_NoFlow_BW(IN := (Cmd_Auto_TP04 AND AIFT_BW <= 0.1), PT := T#10s);

// --- Timer Faults: Flow T1 & T2 ---
TON_T1(IN := (MBR_Step > 0), PT := SET_Delay_T1);
TON_T2_PermHH(IN := (TON_T1.Q AND AIFT_101 >= SET_Flow_Perm_HH AND NOT TON_T2_PermHH.Q), PT := SET_Delay_T2);
TON_T2_PermLL(IN := (TON_T1.Q AND AIFT_101 <= SET_Flow_Perm_LL AND NOT TON_T2_PermLL.Q), PT := SET_Delay_T2);
TON_T2_BWHH(IN := (TON_T1.Q AND AIFT_BW >= SET_Flow_BW_HH AND NOT TON_T2_BWHH.Q), PT := SET_Delay_T2);
TON_T2_BWLL(IN := (TON_T1.Q AND AIFT_BW <= SET_Flow_BW_LL AND NOT TON_T2_BWLL.Q), PT := SET_Delay_T2);

// --- Timer Sequence MBR Filtrasi & MC ---
TON_Tr_Permeate(IN := (MBR_Step = 1), PT := SET_Tr_Permeate);
TON_Ts_Permeate(IN := (MBR_Step = 2), PT := SET_Ts_Permeate);
TON_Tr_Backwash(IN := (MBR_Step = 3), PT := SET_Tr_Backwash);
TON_Dosing(IN := (MC_Step = 1), PT := SET_Tr_Dosing);
TON_Soaking(IN := (MC_Step = 2), PT := SET_Tr_Soaking);
TON_Aeration(IN := (MC_Step = 3), PT := SET_Tr_Aeration);
TON_MC_Backwash(IN := (MC_Step = 4), PT := SET_Tr_MC_Backwash);

// --- Timer Auto Shifting ---
TON_Shift_BL01(IN := (HMI_BL01_Duty_Sel = 3 AND NOT TON_Shift_BL01.Q), PT := T#1h);
TON_Shift_TP03(IN := (HMI_TP03_Duty_Sel = 3 AND NOT TON_Shift_TP03.Q), PT := T#24h);
// TP-04 tidak punya Timer Shifting karena dia pompa Single/Tunggal


// =========================================================================
// 2. EVALUASI GLOBAL SYSTEM ALARMS & FAULTS (DENGAN LATCHING)
// =========================================================================
IF TON_PT101_HH.Q THEN Fault_PT101_HH := TRUE; END_IF;
IF TON_PT_BW_HH.Q THEN Fault_PT_BW_HH := TRUE; END_IF;
IF TON_NoFlow_Permeate.Q THEN Fault_NoFlow_Permeate := TRUE; END_IF;
IF TON_NoFlow_BW.Q THEN Fault_NoFlow_BW := TRUE; END_IF;

IF TON_T2_PermHH.Q THEN Fault_Cnt_PermHH := Fault_Cnt_PermHH + 1; END_IF;
IF Fault_Cnt_PermHH >= 2 THEN Fault_Flow_Perm_HH := TRUE; END_IF;
IF AIFT_101 < SET_Flow_Perm_HH OR NOT TON_T1.Q THEN Fault_Cnt_PermHH := 0; END_IF;

IF TON_T2_PermLL.Q THEN Fault_Cnt_PermLL := Fault_Cnt_PermLL + 1; END_IF;
IF Fault_Cnt_PermLL >= 2 THEN Fault_Flow_Perm_LL := TRUE; END_IF;
IF AIFT_101 > SET_Flow_Perm_LL OR NOT TON_T1.Q THEN Fault_Cnt_PermLL := 0; END_IF;

IF TON_T2_BWHH.Q THEN Fault_Cnt_BWHH := Fault_Cnt_BWHH + 1; END_IF;
IF Fault_Cnt_BWHH >= 2 THEN Fault_Flow_BW_HH := TRUE; END_IF;
IF AIFT_BW < SET_Flow_BW_HH OR NOT TON_T1.Q THEN Fault_Cnt_BWHH := 0; END_IF;

IF TON_T2_BWLL.Q THEN Fault_Cnt_BWLL := Fault_Cnt_BWLL + 1; END_IF;
IF Fault_Cnt_BWLL >= 2 THEN Fault_Flow_BW_LL := TRUE; END_IF;
IF AIFT_BW > SET_Flow_BW_LL OR NOT TON_T1.Q THEN Fault_Cnt_BWLL := 0; END_IF;

STS_System_Fault := Fault_PT101_HH OR Fault_PT_BW_HH OR Fault_NoFlow_Permeate OR Fault_NoFlow_BW OR 
                    Fault_Flow_Perm_HH OR Fault_Flow_Perm_LL OR Fault_Flow_BW_HH OR Fault_Flow_BW_LL;

IF HMI_Reset_Alarm THEN
    Fault_PT101_HH := FALSE; Fault_PT_BW_HH := FALSE; 
    Fault_NoFlow_Permeate := FALSE; Fault_NoFlow_BW := FALSE;
    Fault_Flow_Perm_HH := FALSE; Fault_Flow_Perm_LL := FALSE; 
    Fault_Flow_BW_HH := FALSE; Fault_Flow_BW_LL := FALSE;
END_IF;

IF STS_System_Fault AND NOT HMI_Mute_Buzzer THEN _IO_EM_DO_13 := TRUE; ELSE _IO_EM_DO_13 := FALSE; END_IF;


// =========================================================================
// 3. DUTY SELECTOR, AUTO-BACKUP & TIMER SHIFTING
// =========================================================================
IF (HMI_TP01_Duty_Sel = 1 AND NOT STS_TP01A_Fault) OR (HMI_TP01_Duty_Sel = 2 AND STS_TP01B_Fault) THEN
    Duty_TP01A := TRUE; Duty_TP01B := FALSE;
ELSIF (HMI_TP01_Duty_Sel = 2 AND NOT STS_TP01B_Fault) OR (HMI_TP01_Duty_Sel = 1 AND STS_TP01A_Fault) THEN
    Duty_TP01A := FALSE; Duty_TP01B := TRUE;
ELSE Duty_TP01A := FALSE; Duty_TP01B := FALSE; END_IF;

IF (HMI_TP02_Duty_Sel = 1 AND NOT STS_TP02A_Fault) OR (HMI_TP02_Duty_Sel = 2 AND STS_TP02B_Fault) THEN
    Duty_TP02A := TRUE; Duty_TP02B := FALSE;
ELSIF (HMI_TP02_Duty_Sel = 2 AND NOT STS_TP02B_Fault) OR (HMI_TP02_Duty_Sel = 1 AND STS_TP02A_Fault) THEN
    Duty_TP02A := FALSE; Duty_TP02B := TRUE;
ELSE Duty_TP02A := FALSE; Duty_TP02B := FALSE; END_IF;

IF TON_Shift_TP03.Q THEN
    IF Duty_TP03A = TRUE THEN Duty_TP03A := FALSE; Duty_TP03B := TRUE; ELSE Duty_TP03A := TRUE; Duty_TP03B := FALSE; END_IF;
END_IF;
IF HMI_TP03_Duty_Sel = 3 THEN
    IF NOT Duty_TP03A AND NOT Duty_TP03B THEN Duty_TP03A := TRUE; END_IF; 
ELSIF (HMI_TP03_Duty_Sel = 1 AND NOT STS_TP03A_Fault) OR (HMI_TP03_Duty_Sel = 2 AND STS_TP03B_Fault) THEN
    Duty_TP03A := TRUE; Duty_TP03B := FALSE;
ELSIF (HMI_TP03_Duty_Sel = 2 AND NOT STS_TP03B_Fault) OR (HMI_TP03_Duty_Sel = 1 AND STS_TP03A_Fault) THEN
    Duty_TP03A := FALSE; Duty_TP03B := TRUE;
ELSE Duty_TP03A := FALSE; Duty_TP03B := FALSE; END_IF;

IF TON_Shift_BL01.Q THEN
    IF Duty_BL01A = TRUE THEN Duty_BL01A := FALSE; Duty_BL01B := TRUE; ELSE Duty_BL01A := TRUE; Duty_BL01B := FALSE; END_IF;
END_IF;
IF HMI_BL01_Duty_Sel = 3 THEN
    IF NOT Duty_BL01A AND NOT Duty_BL01B THEN Duty_BL01A := TRUE; END_IF; 
ELSIF (HMI_BL01_Duty_Sel = 1 AND NOT STS_BL01A_Fault) OR (HMI_BL01_Duty_Sel = 2 AND STS_BL01B_Fault) THEN
    Duty_BL01A := TRUE; Duty_BL01B := FALSE;
ELSIF (HMI_BL01_Duty_Sel = 2 AND NOT STS_BL01B_Fault) OR (HMI_BL01_Duty_Sel = 1 AND STS_BL01A_Fault) THEN
    Duty_BL01A := FALSE; Duty_BL01B := TRUE;
ELSE Duty_BL01A := FALSE; Duty_BL01B := FALSE; END_IF;


// =========================================================================
// 4. SEQUENCE AUTO: SUMPIT & EQUALIZING TANK
// =========================================================================
IF _IO_EM_DI_12 = TRUE AND _IO_EM_DI_13 = FALSE THEN Cmd_Auto_TP01 := TRUE;
ELSIF _IO_EM_DI_12 = FALSE OR _IO_EM_DI_13 = TRUE THEN Cmd_Auto_TP01 := FALSE; END_IF;

IF _IO_EM_DI_13 = TRUE AND _IO_EM_DI_16 = FALSE THEN Cmd_Auto_TP02 := TRUE; Cmd_Auto_AGT101 := TRUE;
ELSIF _IO_EM_DI_13 = FALSE OR _IO_EM_DI_16 = TRUE THEN Cmd_Auto_TP02 := FALSE; Cmd_Auto_AGT101 := FALSE; END_IF;


// =========================================================================
// 5. SEQUENCE AUTO: MBR FILTRATION (PCP Bab 4)
// =========================================================================
IF _IO_EM_DI_15 = TRUE THEN MBR_Level_OK := TRUE; END_IF; 
IF _IO_EM_DI_14 = FALSE THEN MBR_Level_OK := FALSE; END_IF;

IF MBR_Level_OK AND NOT DI_Effluent_HH AND NOT STS_System_Fault AND NOT STS_MC_Running THEN
    
    IF MBR_Step = 0 THEN Cycle_Count := 0; MBR_Step := 1; END_IF;

    CASE MBR_Step OF
        1:  // PERMEATE RUN
            // UPDATE FINAL: Absolut Interlock Stop jika Pressure Fault/H
            IF NOT TON_PT101_H.Q AND NOT Fault_PT101_HH THEN 
                Cmd_Auto_TP03 := TRUE; 
            ELSE 
                Cmd_Auto_TP03 := FALSE; 
            END_IF;
            Cmd_Auto_TP04 := FALSE;
            IF TON_Tr_Permeate.Q THEN MBR_Step := 2; END_IF;

        2:  // SLACK
            Cmd_Auto_TP03 := FALSE; Cmd_Auto_TP04 := FALSE;
            IF TON_Ts_Permeate.Q THEN
                Cycle_Count := Cycle_Count + 1;
                IF Cycle_Count >= 4 THEN MBR_Step := 3; ELSE MBR_Step := 1; END_IF;
            END_IF;

        3:  // BACKWASH
            Cmd_Auto_TP03 := FALSE; 
            // UPDATE FINAL: Absolut Interlock Stop jika BW Pressure Fault/H atau Tangki LL
            IF DI_BWTank_H AND NOT DI_BWTank_LL AND NOT TON_PT_BW_H.Q AND NOT Fault_PT_BW_HH THEN 
                Cmd_Auto_TP04 := TRUE; 
            ELSE 
                Cmd_Auto_TP04 := FALSE; 
            END_IF;
            
            IF TON_Tr_Backwash.Q THEN Cycle_Count := 0; MBR_Step := 1; END_IF;
    END_CASE;
    
    Cmd_Auto_BL01 := TRUE; 

ELSE
    MBR_Step := 0; Cmd_Auto_TP03 := FALSE; Cmd_Auto_TP04 := FALSE; Cmd_Auto_BL01 := FALSE;
END_IF;


// =========================================================================
// 6. SEQUENCE AUTO: MAINTENANCE CLEANING (PCP Bab 5)
// =========================================================================
IF HMI_Start_MC_Prog AND NOT STS_System_Fault AND _IO_EM_DI_13 = TRUE THEN STS_MC_Running := TRUE; 
ELSE STS_MC_Running := FALSE; END_IF;

IF STS_MC_Running THEN
    IF MC_Step = 0 THEN MC_Step := 1; END_IF;

    CASE MC_Step OF
        1:  // DOSING
            Cmd_MC_XVXX := FALSE; Cmd_MC_TP03 := FALSE; Cmd_MC_BL01 := FALSE; Cmd_MC_DP01 := TRUE;
            // UPDATE FINAL: Absolut Interlock Pressure BW di MC
            IF DI_BWTank_H AND NOT DI_BWTank_LL AND NOT Fault_PT_BW_HH THEN Cmd_MC_TP04 := TRUE; ELSE Cmd_MC_TP04 := FALSE; END_IF;
            IF TON_Dosing.Q THEN MC_Step := 2; END_IF;

        2:  // SOAKING
            Cmd_MC_TP04 := FALSE; Cmd_MC_DP01 := FALSE;
            IF TON_Soaking.Q THEN MC_Step := 3; END_IF;

        3:  // AERATION
            Cmd_MC_BL01 := TRUE;
            IF TON_Aeration.Q THEN MC_Step := 4; END_IF;

        4:  // BACKWASH
            Cmd_MC_BL01 := TRUE; 
            IF DI_BWTank_H AND NOT DI_BWTank_LL AND NOT Fault_PT_BW_HH THEN Cmd_MC_TP04 := TRUE; ELSE Cmd_MC_TP04 := FALSE; END_IF;
            IF TON_MC_Backwash.Q THEN Cmd_MC_TP04 := FALSE; MC_Step := 5; END_IF;

        5:  // RETURN TO FILTRATION
            Cmd_MC_XVXX := TRUE; Cmd_MC_TP03 := TRUE; Cmd_MC_BL01 := TRUE; Cmd_MC_TP04 := FALSE;
            HMI_Start_MC_Prog := FALSE; STS_MC_Running := FALSE; MC_Step := 0; 
    END_CASE;
ELSE
    MC_Step := 0; Cmd_MC_XVXX := FALSE; Cmd_MC_TP03 := FALSE; Cmd_MC_BL01 := FALSE; Cmd_MC_TP04 := FALSE; Cmd_MC_DP01 := FALSE;
END_IF;


// =========================================================================
// 7. COMMAND MASTER RESOLUTION & MANUAL LATCHING
// =========================================================================
IF STS_MC_Running THEN
    Cmd_Master_TP03 := Cmd_MC_TP03; Cmd_Master_TP04 := Cmd_MC_TP04; Cmd_Master_BL01 := Cmd_MC_BL01;
    Cmd_Master_DP01 := Cmd_MC_DP01; Cmd_Master_XVXX := Cmd_MC_XVXX;
ELSE
    Cmd_Master_TP03 := Cmd_Auto_TP03; Cmd_Master_TP04 := Cmd_Auto_TP04; Cmd_Master_BL01 := Cmd_Auto_BL01;
    Cmd_Master_DP01 := FALSE; 
    IF DI_BWTank_HH THEN Cmd_Master_XVXX := FALSE; ELSE Cmd_Master_XVXX := TRUE; END_IF;
END_IF;

Out_Man_TP01A := (HMI_TP01A_Start OR Out_Man_TP01A) AND NOT HMI_TP01A_Stop AND NOT STS_TP01A_Fault;
Out_Man_TP01B := (HMI_TP01B_Start OR Out_Man_TP01B) AND NOT HMI_TP01B_Stop AND NOT STS_TP01B_Fault;
Out_Man_TP02A := (HMI_TP02A_Start OR Out_Man_TP02A) AND NOT HMI_TP02A_Stop AND NOT STS_TP02A_Fault;
Out_Man_TP02B := (HMI_TP02B_Start OR Out_Man_TP02B) AND NOT HMI_TP02B_Stop AND NOT STS_TP02B_Fault;
Out_Man_TP03A := (HMI_TP03A_Start OR Out_Man_TP03A) AND NOT HMI_TP03A_Stop AND NOT STS_TP03A_Fault;
Out_Man_TP03B := (HMI_TP03B_Start OR Out_Man_TP03B) AND NOT HMI_TP03B_Stop AND NOT STS_TP03B_Fault;
Out_Man_TP04  := (HMI_TP04A_Start OR Out_Man_TP04)  AND NOT HMI_TP04A_Stop AND NOT STS_TP04A_Fault; 
Out_Man_BL01A := (HMI_BL01A_Start OR Out_Man_BL01A) AND NOT HMI_BL01A_Stop AND NOT STS_BL01A_Fault;
Out_Man_BL01B := (HMI_BL01B_Start OR Out_Man_BL01B) AND NOT HMI_BL01B_Stop AND NOT STS_BL01B_Fault;
Out_Man_AGT101:= (HMI_AGT101_Start OR Out_Man_AGT101) AND NOT HMI_AGT101_Stop AND NOT STS_AGT101_Fault;
Out_Man_DP01  := (HMI_DP01_Start OR Out_Man_DP01) AND NOT HMI_DP01_Stop AND NOT STS_DP01_Fault;
Out_Man_XVXX  := (HMI_XV_XX_Open OR Out_Man_XVXX) AND NOT HMI_XV_XX_Close;
Out_Man_VES120 := (HMI_VES120_Open OR Out_Man_VES120) AND NOT HMI_VES120_Close;


// =========================================================================
// 8. FINAL OUTPUT MAPPING KE FISIK (DO)
// =========================================================================
IF HMI_Mode_Auto = TRUE THEN
    _IO_EM_DO_00 := Cmd_Auto_TP01 AND Duty_TP01A;   
    _IO_EM_DO_01 := Cmd_Auto_TP01 AND Duty_TP01B;   
    _IO_EM_DO_02 := Cmd_Auto_TP02 AND Duty_TP02A;   
    _IO_EM_DO_03 := Cmd_Auto_TP02 AND Duty_TP02B;   
    _IO_EM_DO_04 := Cmd_Master_TP03 AND Duty_TP03A; 
    _IO_EM_DO_05 := Cmd_Master_TP03 AND Duty_TP03B; 
    _IO_EM_DO_06 := Cmd_Master_TP04;                
    _IO_EM_DO_07 := Cmd_Master_BL01 AND Duty_BL01A; 
    _IO_EM_DO_08 := Cmd_Master_BL01 AND Duty_BL01B; 
    _IO_EM_DO_09 := Cmd_Auto_AGT101;                
    _IO_EM_DO_10 := Cmd_Master_DP01;                
    _IO_EM_DO_11 := Cmd_Master_XVXX;                
    _IO_EM_DO_12 := Out_Man_VES120; // Tetap Manual di mode apa pun
ELSE
    _IO_EM_DO_00 := Out_Man_TP01A; _IO_EM_DO_01 := Out_Man_TP01B; _IO_EM_DO_02 := Out_Man_TP02A;
    _IO_EM_DO_03 := Out_Man_TP02B; _IO_EM_DO_04 := Out_Man_TP03A; _IO_EM_DO_05 := Out_Man_TP03B;
    _IO_EM_DO_06 := Out_Man_TP04;  _IO_EM_DO_07 := Out_Man_BL01A; _IO_EM_DO_08 := Out_Man_BL01B;
    _IO_EM_DO_09 := Out_Man_AGT101; _IO_EM_DO_10 := Out_Man_DP01; _IO_EM_DO_11 := Out_Man_XVXX;
    _IO_EM_DO_12 := Out_Man_VES120;
END_IF;

STS_TP01A_Run := _IO_EM_DO_00; STS_TP01B_Run := _IO_EM_DO_01; STS_TP02A_Run := _IO_EM_DO_02; STS_TP02B_Run := _IO_EM_DO_03;
STS_TP03A_Run := _IO_EM_DO_04; STS_TP03B_Run := _IO_EM_DO_05; STS_TP04A_Run := _IO_EM_DO_06; STS_BL01A_Run := _IO_EM_DO_07;
STS_BL01B_Run := _IO_EM_DO_08; STS_AGT101_Run:= _IO_EM_DO_09; STS_DP01_Run  := _IO_EM_DO_10; STS_XV_XX_IsOpen := _IO_EM_DO_11;
END_PROGRAM